# =============================================================================
# SKYTECH AIRLINES — Module 3: Environment Configuration Template
# Copy this file to .env or set environment variables in your OS/IDE.
# NEVER commit real credentials to GitHub or public repositories.
# =============================================================================

# Database Configuration (MySQL 8.4 LTS / MySQL 8.0+)
SKYTECH_DB_URL=jdbc:mysql://localhost:3306/skytech_airlines_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SKYTECH_DB_USER=root
SKYTECH_DB_PASSWORD=your_mysql_password_here

# Razorpay Standard Checkout Credentials (Test Mode)
# Obtain from: https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Currency Configuration (Mandatory exact INR)
RAZORPAY_CURRENCY=INR

# Seat Hold Expiry Duration (Seconds - Default: 900 = 15 Minutes)
SEAT_HOLD_DURATION_SECONDS=900

# Application Server Port (Standalone runner mode)
APP_PORT=8080
