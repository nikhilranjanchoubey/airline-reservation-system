<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>SkyTech - Airline Reservation System</display-name>

    <!-- Character Encoding Filter -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.skytech.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Home Controller Servlet -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.skytech.controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Flight Search Controller Servlet -->
    <servlet>
        <servlet-name>FlightSearchController</servlet-name>
        <servlet-class>com.skytech.controller.FlightSearchController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightSearchController</servlet-name>
        <url-pattern>/search-flights</url-pattern>
    </servlet-mapping>

    <!-- Flight Details Controller Servlet -->
    <servlet>
        <servlet-name>FlightDetailsController</servlet-name>
        <servlet-class>com.skytech.controller.FlightDetailsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightDetailsController</servlet-name>
        <url-pattern>/flight-details</url-pattern>
    </servlet-mapping>

    <!-- Flight Results Controller Servlet -->
    <servlet>
        <servlet-name>FlightResultsController</servlet-name>
        <servlet-class>com.skytech.controller.FlightResultsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightResultsController</servlet-name>
        <url-pattern>/flight-results</url-pattern>
    </servlet-mapping>

    <!-- Seat Selection Controller Servlet -->
    <servlet>
        <servlet-name>SeatSelectionController</servlet-name>
        <servlet-class>com.skytech.controller.SeatSelectionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SeatSelectionController</servlet-name>
        <url-pattern>/seat-selection</url-pattern>
    </servlet-mapping>

    <!-- Airport Autocomplete API Servlet -->
    <servlet>
        <servlet-name>AirportSearchApiController</servlet-name>
        <servlet-class>com.skytech.controller.AirportSearchApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AirportSearchApiController</servlet-name>
        <url-pattern>/api/airports</url-pattern>
    </servlet-mapping>

    <!-- Manage Booking & Cancellation Controller Servlet -->
    <servlet>
        <servlet-name>ManageBookingController</servlet-name>
        <servlet-class>com.skytech.controller.ManageBookingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageBookingController</servlet-name>
        <url-pattern>/manage-booking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManageBookingController</servlet-name>
        <url-pattern>/booking/cancel</url-pattern>
    </servlet-mapping>

    <!-- Flight Booking Workflow Controller -->
    <servlet>
        <servlet-name>BookingController</servlet-name>
        <servlet-class>com.skytech.controller.BookingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingController</servlet-name>
        <url-pattern>/book-flight</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookingController</servlet-name>
        <url-pattern>/booking/passenger-details</url-pattern>
    </servlet-mapping>

    <!-- Payment & Razorpay Checkout Controller -->
    <servlet>
        <servlet-name>PaymentController</servlet-name>
        <servlet-class>com.skytech.controller.PaymentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentController</servlet-name>
        <url-pattern>/booking/checkout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentController</servlet-name>
        <url-pattern>/booking/verify-payment</url-pattern>
    </servlet-mapping>

    <!-- Booking Confirmation Controller -->
    <servlet>
        <servlet-name>ConfirmationController</servlet-name>
        <servlet-class>com.skytech.controller.ConfirmationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmationController</servlet-name>
        <url-pattern>/booking/confirmation</url-pattern>
    </servlet-mapping>

    <!-- Ticket & Boarding Pass Controller -->
    <servlet>
        <servlet-name>TicketController</servlet-name>
        <servlet-class>com.skytech.controller.TicketController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TicketController</servlet-name>
        <url-pattern>/ticket/download</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TicketController</servlet-name>
        <url-pattern>/ticket/view</url-pattern>
    </servlet-mapping>

    <!-- Passenger Dashboard ("My Trips") Controller -->
    <servlet>
        <servlet-name>PassengerDashboardController</servlet-name>
        <servlet-class>com.skytech.controller.PassengerDashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PassengerDashboardController</servlet-name>
        <url-pattern>/my-bookings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PassengerDashboardController</servlet-name>
        <url-pattern>/my-trips</url-pattern>
    </servlet-mapping>


    <!-- Flight Status Controller Servlet -->
    <servlet>
        <servlet-name>FlightStatusController</servlet-name>
        <servlet-class>com.skytech.controller.FlightStatusController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightStatusController</servlet-name>
        <url-pattern>/flight-status</url-pattern>
    </servlet-mapping>

    <!-- Travel Information Controller Servlet -->
    <servlet>
        <servlet-name>TravelInfoController</servlet-name>
        <servlet-class>com.skytech.controller.TravelInfoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TravelInfoController</servlet-name>
        <url-pattern>/travel-information</url-pattern>
    </servlet-mapping>

    <!-- Project Architecture Documentation (Academic / Evaluator) -->
    <servlet>
        <servlet-name>ProjectController</servlet-name>
        <servlet-class>com.skytech.controller.ProjectController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProjectController</servlet-name>
        <url-pattern>/project</url-pattern>
    </servlet-mapping>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Management: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/errors/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/errors/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>
