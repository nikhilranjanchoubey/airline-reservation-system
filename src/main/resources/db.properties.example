# ==============================================================================
# SkyTech - Airline Reservation System
# Database Connection Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file as 'db.properties' in the same folder (src/main/resources/).
# 2. Update with your local MySQL credentials.
# 3. 'db.properties' is ignored by Git to protect sensitive credentials.
# ==============================================================================

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/skytech_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=your_mysql_password
